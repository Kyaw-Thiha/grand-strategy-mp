[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/lobby/lobby_ui.gd" id="1"]

[node name="Lobby" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="VBox" type="VBoxContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = 16.0
offset_right = -16.0
offset_bottom = -16.0

[node name="Header" type="HBoxContainer" parent="VBox"]

[node name="CodeLabel" type="Label" parent="VBox/Header"]
unique_name_in_owner = true
text = "Lobby  •  Code: ------"
theme_override_font_sizes/font_size = 18

[node name="HSep" type="HSeparator" parent="VBox"]
layout_mode = 2

[node name="Content" type="HSplitContainer" parent="VBox"]
layout_mode = 2
size_flags_vertical = 3
split_offset = 220

[node name="NationsPane" type="VBoxContainer" parent="VBox/Content"]
layout_mode = 2

[node name="NationsTitle" type="Label" parent="VBox/Content/NationsPane"]
text = "Nations"
theme_override_font_sizes/font_size = 14

[node name="NationsList" type="VBoxContainer" parent="VBox/Content/NationsPane"]
unique_name_in_owner = true
layout_mode = 2

[node name="PlayersPane" type="VBoxContainer" parent="VBox/Content"]
layout_mode = 2

[node name="PlayersTitle" type="Label" parent="VBox/Content/PlayersPane"]
text = "Players"
theme_override_font_sizes/font_size = 14

[node name="PlayersList" type="VBoxContainer" parent="VBox/Content/PlayersPane"]
unique_name_in_owner = true
layout_mode = 2

[node name="Footer" type="HBoxContainer" parent="VBox"]

[node name="StatusLabel" type="Label" parent="VBox/Footer"]
unique_name_in_owner = true
size_flags_horizontal = 3
text = ""

[node name="ReadyBtn" type="Button" parent="VBox/Footer"]
unique_name_in_owner = true
text = "Ready Up"

[node name="StartBtn" type="Button" parent="VBox/Footer"]
unique_name_in_owner = true
text = "Start"
visible = false

[connection signal="pressed" from="VBox/Footer/ReadyBtn" to="." method="_on_ready_btn_pressed"]
[connection signal="pressed" from="VBox/Footer/StartBtn" to="." method="_on_start_btn_pressed"]
