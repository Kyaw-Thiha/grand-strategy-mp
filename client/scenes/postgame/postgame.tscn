[node name="MainMenuBtn" type="Button" parent="Center/VBox"]
unique_name_in_owner = true
text = "Return to Main Menu"

[connection signal="pressed" from="Center/VBox/MainMenuBtn" to="." method="_on_main_menu_btn_pressed"]
