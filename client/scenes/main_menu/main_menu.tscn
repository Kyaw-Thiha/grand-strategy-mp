[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/main_menu/main_menu.gd" id="1"]

[node name="MainMenu" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="Center" type="CenterContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0

[node name="VBox" type="VBoxContainer" parent="Center"]
custom_minimum_size = Vector2(320, 0)

[node name="Title" type="Label" parent="Center/VBox"]
text = "Grand Strategy"
theme_override_font_sizes/font_size = 28
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="Center/VBox"]
custom_minimum_size = Vector2(0, 16)

[node name="EmailLabel" type="Label" parent="Center/VBox"]
text = "Email"

[node name="EmailField" type="LineEdit" parent="Center/VBox" unique_name_in_owner=true]
placeholder_text = "user@example.com"

[node name="PassLabel" type="Label" parent="Center/VBox"]
text = "Password"

[node name="PassField" type="LineEdit" parent="Center/VBox" unique_name_in_owner=true]
placeholder_text = "••••••••"
secret = true

[node name="LoginBtn" type="Button" parent="Center/VBox" unique_name_in_owner=true]
text = "Login"

[node name="StatusLabel" type="Label" parent="Center/VBox" unique_name_in_owner=true]
text = ""
autowrap_mode = 3

[node name="PostLogin" type="VBoxContainer" parent="Center/VBox" unique_name_in_owner=true]
visible = false

[node name="Separator" type="HSeparator" parent="Center/VBox/PostLogin"]

[node name="CreateGameBtn" type="Button" parent="Center/VBox/PostLogin" unique_name_in_owner=true]
text = "Create Game"

[node name="JoinRow" type="HBoxContainer" parent="Center/VBox/PostLogin"]

[node name="JoinCodeField" type="LineEdit" parent="Center/VBox/PostLogin/JoinRow" unique_name_in_owner=true]
size_flags_horizontal = 3
placeholder_text = "Join code"
max_length = 6

[node name="JoinBtn" type="Button" parent="Center/VBox/PostLogin/JoinRow" unique_name_in_owner=true]
text = "Join"

[node name="BrowseBtn" type="Button" parent="Center/VBox/PostLogin" unique_name_in_owner=true]
text = "Browse Public Games"

[connection signal="pressed" from="Center/VBox/LoginBtn" to="." method="_on_login_btn_pressed"]
[connection signal="pressed" from="Center/VBox/PostLogin/CreateGameBtn" to="." method="_on_create_game_btn_pressed"]
[connection signal="pressed" from="Center/VBox/PostLogin/JoinRow/JoinBtn" to="." method="_on_join_btn_pressed"]
[connection signal="pressed" from="Center/VBox/PostLogin/BrowseBtn" to="." method="_on_browse_btn_pressed"]
