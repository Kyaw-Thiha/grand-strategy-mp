[sub_resource type="Shader" id="Shader_icon_tint"]
code = "shader_type canvas_item;

uniform vec4 icon_color : source_color = vec4(0.96, 0.78, 0.38, 1.0);

void fragment() {
	vec4 tex = texture(TEXTURE, UV);
	COLOR = vec4(icon_color.rgb, tex.a * icon_color.a * COLOR.a);
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_icon_tint"]
shader = SubResource("Shader_icon_tint")
shader_parameter/icon_color = Color(0.96, 0.78, 0.38, 1)

