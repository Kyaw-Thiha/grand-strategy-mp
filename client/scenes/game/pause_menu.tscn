[sub_resource type="Shader" id="Shader_pause_blur"]
code = "shader_type canvas_item;

uniform sampler2D screen_texture : hint_screen_texture, repeat_disable, filter_linear_mipmap;
uniform float blur_strength = 0.0;

void fragment() {
	vec2 px = SCREEN_PIXEL_SIZE * blur_strength;
	vec4 color = texture(screen_texture, SCREEN_UV) * 0.20;
	color += texture(screen_texture, SCREEN_UV + vec2(px.x, 0.0)) * 0.12;
	color += texture(screen_texture, SCREEN_UV - vec2(px.x, 0.0)) * 0.12;
	color += texture(screen_texture, SCREEN_UV + vec2(0.0, px.y)) * 0.12;
	color += texture(screen_texture, SCREEN_UV - vec2(0.0, px.y)) * 0.12;
	color += texture(screen_texture, SCREEN_UV + vec2(px.x, px.y)) * 0.08;
	color += texture(screen_texture, SCREEN_UV + vec2(-px.x, px.y)) * 0.08;
	color += texture(screen_texture, SCREEN_UV + vec2(px.x, -px.y)) * 0.08;
	color += texture(screen_texture, SCREEN_UV + vec2(-px.x, -px.y)) * 0.08;
	COLOR = color;
}
"

