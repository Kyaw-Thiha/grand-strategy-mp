# Godot 4+ specific ignores
.godot/
/android/

# Export credentials (contain signing keys)
export_credentials.cfg

# Godot export output
/builds/
*.apk
*.aab
*.ipa
*.exe
*.dmg

# Local endpoint override. Copy server_config.example.json to this path.
server_config.json

# OS noise
.DS_Store
Thumbs.db

assets/source
# assets/data holds map-pipeline-generated output (regenerated, not committed) — EXCEPT
# assets/data/research/, hand-authored source content tracked despite living in the same
# parent directory (Phase 11 Branch A). Git requires ignoring via a wildcard, not the bare
# directory name, for a subdirectory negation below to actually take effect.
assets/data/*
!assets/data/research/
