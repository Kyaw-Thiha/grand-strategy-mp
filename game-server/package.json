{
  "private": true,
  "name": "my-app",
  "version": "0.17.0",
  "description": "npm init template for bootstrapping an empty Colyseus project",
  "type": "module",
  "main": "build/index.js",
  "engines": {
    "node": ">= 20.9.0"
  },
  "scripts": {
    "start": "tsx watch src/index.ts",
    "loadtest": "tsx loadtest/example.ts --room my_room --numClients 2",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf build",
    "test": "NODE_ENV=test mocha 'test/GameRoom.test.ts' 'test/movement-jerk.test.ts' 'test/6a-grid-schema.test.ts' 'test/6b-perk-extensibility.test.ts' 'test/6b-round-system.test.ts' 'test/6-phase-gate.test.ts' 'test/6c-combat-stats.test.ts' 'test/6d-infantry-patterns.test.ts' 'test/6f-special-patterns.test.ts' 'test/6g-xp-stealth.test.ts' 'test/6h-row-perks.test.ts' 'test/6j-terrain-modifiers.test.ts' 'test/12a-air-wing-schema.test.ts' 'test/12b-air-wing-lifecycle.test.ts' 'test/12b-patch-lifecycle-handlers.test.ts' 'test/12c-dubins-path.test.ts' 'test/12d-air-detection.test.ts' 'test/12e-air-combat.test.ts' 'test/12f-air-bombing-patterns.test.ts' 'test/12e-patch-formation-density.test.ts'",
    "bot-fight": "NODE_ENV=development tsx scripts/bot_fight.ts"
  },
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/colyseus/create-colyseus/issues"
  },
  "homepage": "https://github.com/colyseus/create-colyseus#readme",
  "devDependencies": {
    "@colyseus/loadtest": "^0.17.7",
    "@colyseus/sdk": "^0.17.17",
    "@colyseus/testing": "^0.17.10",
    "@types/express": "^4.17.1",
    "@types/mocha": "^10.0.1",
    "mocha": "^8.1.3",
    "rimraf": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "@colyseus/schema": "^4.0.0",
    "@colyseus/tools": "^0.17.0",
    "colyseus": "^0.17.10",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "jose": "^6.2.3"
  }
}
